rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to read any avatars, but only write to their own avatar path
    match /avatars/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default fallback (requires auth for other paths)
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
