rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['username', 'lastUsernameChange']) 
          || (
            request.resource.data.username != resource.data.username
            && request.resource.data.lastUsernameChange == request.time
            && (!('lastUsernameChange' in resource.data) || resource.data.lastUsernameChange < request.time - duration.value(14, 'd'))
          )
        );
    }
    
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Allow reading games (everyone can see, only creator or player joining/leaving can update)
    match /games/{gameId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentPlayers', 'status'])
      );
      allow delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.creatorId == request.auth.uid
      );
    }

    // Allow anyone to read courts, but prevent client writes (must be seeded/managed)
    match /courts/{courtId} {
      allow read: if true;
      allow write: if false;
    }
  }
}

