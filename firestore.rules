rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow logged in users to read profiles, only owner can write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow reading games (everyone can see, only creator or player joining/leaving can update)
    match /games/{gameId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentPlayers', 'status'])
      );
      allow delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.creatorId == request.auth.uid
      );
    }

    // Allow anyone to read courts, but prevent client writes (must be seeded/managed)
    match /courts/{courtId} {
      allow read: if true;
      allow write: if false;
    }
  }
}

