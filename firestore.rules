rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow reading games (everyone can see, only creator can edit)
    match /games/{gameId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.creatorId == request.auth.uid || resource.data.createdBy == request.auth.uid);
    }

    // Allow anyone to read courts, but prevent client writes (must be seeded/managed)
    match /courts/{courtId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
